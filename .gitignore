.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/
# TypeScript incremental-build cache — changes on every build.
*.tsbuildinfo
build/
*.spec.bak
# Runtime data: the local DB holds DPAPI-encrypted credentials and must never
# be committed, even encrypted.
agent/data/
*.db
*.db-journal
*.log
lab/media/
# Lab runtime: MediaMTX binary (downloaded, not ours), generated configs, the
# lab agent's setup token + DB.
lab/bin/
lab/run/
# MediaMTX writes a self-signed TLS cert + PRIVATE KEY into its working dir.
auto.crt
auto.key
*.key

# Model binaries: pinned by SHA-256 in app/ai/model_manager.py, fetched separately.
agent/models/
lab/clips/
